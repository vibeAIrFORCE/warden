# Warden configuration — copy to .env (or export these in your shell/profile).
# Every value below is OPTIONAL; the agent fails closed and tells you what
# it needs. NOTHING here is required to run the teeth battery (`uv run pytest`).

# ── SIGNALS (where the follow list comes from) ──────────────────────────────
# The default feed is VIBE's priced delivered-signals SKU. Three lanes:
#   1. FREE TRIAL (no account)  — mint a token, works immediately:
#        curl -s -X POST https://api.vibe.airforce/api/vibe-tools/trial-auth
#      Trial tokens are capped (~3 calls per token per day) — smoke-test only.
#   2. API KEY + CREDITS (the real lane) — get one at
#        https://www.vibe.airforce/developers  →  top up credits  →
#        create the key pair (pk_…:sk_…). This lane wins when both are set.
#   3. NOTHING SET — the provider raises SignalsUnavailable(402) honestly.
#        It NEVER returns a fake-empty book.
VIBE_API_KEY=pk_your_public:sk_your_secret      # lane 2 — per-call credits
VIBE_TRIAL_TOKEN=trial_1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d   # lane 1 — free (~3 calls); paste YOUR minted token, the WHOLE string, never dots

# ── YOUR PREFERENCES (optional — narrow the book to your slice) ─────────────
# All three are OPTIONAL; absent = follow whatever the book delivers. Invalid
# values fail closed to absent with one startup warning — never a crash.
WARDEN_TICKERS=USELESS,BTC    # comma-separated coins — only follow these
WARDEN_MIN_CONVICTION=60      # conviction floor, float 0-100
WARDEN_SIDES=SHORT            # LONG and/or SHORT, comma-separated

# ── BRAIN (the veto decision model) ─────────────────────────────────────────
# NearBrain — any OpenAI chat/completions endpoint. NEAR AI Cloud serves it:
#   https://cloud-api.near.ai/v1   (note the /v1 suffix — included)
# Your NEAR AI Cloud key (create at cloud-api.near.ai). Read at call time;
# never baked, never logged. Absent → every decide() refuses fail-closed
# and the agent falls back to HeuristicBrain at startup.
WARDEN_BRAIN_URL=https://cloud-api.near.ai/v1
NEAR_API_KEY=

# ── EXECUTOR (Hyperliquid — REAL ORDERS when armed) ─────────────────────────
# The executor is INERT until BOTH keys are set. Arming ritual:
#   1. generate a DEDICATED TESTNET-ONLY key (never a production key):
#        uv run --extra hl python -c "import os; from eth_account import Account; \
#          print(Account.from_key(os.urandom(32).hex()).key.hex())"
#   2. fund it on TESTNET (faucet/transfer) — see README 'Arm the executor'
#   3. run the fire test — it must PASS and print the marker:
#        uv run --extra hl python scripts/fire_test.py order --coin BTC --notional 15
#   4. THEN export the two keys below.
WARDEN_PRIVATE_KEY=          # 0x… — the trading wallet's key (TESTNET ONLY)
WARDEN_ENV=testnet           # testnet | prod  (prod requires the same ritual)
WARDEN_ENABLED=              # 1 = armed (only after a PASSING fire test)
WARDEN_TESTNET_FIRE_TEST=    # 'pass' — the recorded evidence marker

# ── MISC ────────────────────────────────────────────────────────────────────
WARDEN_DRY=1                 # 1 = decisions print, nothing sends (default)
WARDEN_LEDGER=warden_ledger.jsonl
